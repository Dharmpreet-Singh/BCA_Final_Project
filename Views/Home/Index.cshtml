            </div>
        </div>
    </div>
</section>
<!-- Slider end -->
<!-- Category Grid -->
<section class="categories">


    @foreach (var item in Model.categoryMdl)
    {

        <div class="cat">
            <a href="@Url.Action("Shop","Home",new { cid=item.c_id})"><img src="@item.c_image" alt="image"></a>
            <div class="cname">@item.c_name</div>
        </div>
            }

               </section>

<!-- Best Selling Products -->
<section class="Products1">
    <div class="PdtHead1">
        <h3>Best Selling Products</h3>
    </div>
    <div class="PdtBody1">

        @foreach (var item in ViewBag.ProductList)
        {
            <div class="product-item">
                <div class="product-img">
                    <img src="@item.pa_image" alt="@item.pa_name" />
                </div>
                <div class="product-details">
                    <h5 class="product-name">@item.pa_name</h5>
                    <div class="product-price">Price: ₹@item.pa_price/only-</div>
                </div>
                <a href="@Url.Action("Product_View", "Home", new { id = item.pa_id })" class="view-item-btn">View Item</a>
            </div>
        }

