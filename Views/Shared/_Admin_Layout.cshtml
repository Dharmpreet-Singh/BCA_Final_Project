<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/Content/Site.css" rel="stylesheet" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
</head>
<body>
    <!-- Header Start -->
    <header>
        <article class="head">
            <div class="logo">
                <img src="~/images/dp mart 2.png" alt="">
            </div>
            <div class="mid">
                <h2>Admin's Platform</h2>
            </div>
            <div class="icons">
                @*<button><i class="fa-regular fa-user"></i></button>
                    <button><i class="fa-regular fa-heart"></i></button>
                    <button>
                        <i class="fa-solid fa-cart-shopping"></i>
                    </button>*@
            </div>
        </article>
        <nav class="menu-bar ad_menu-bar">
            <div class="menu ad_menu">
                <ul>
                    <li><a href=@Url.Action("Home","admin")>Home</a></li>
                    <li><a href=@Url.Action("My_Product","admin")>Products</a></li>
                    <li><a href=@Url.Action("Product_Dtl","admin")>Product Detail</a></li>
                    <li><a href=@Url.Action("Category","admin")>Category</a></li>
                    <li><a href=@Url.Action("Sub_Cat","admin")>Subcategory</a></li>
                    <li><a href=@Url.Action("Feedback","admin")>Feedbacks</a></li>
                    <li><a href=@Url.Action("User_orders","admin")>Orders</a></li>
                </ul>
                <div class="Username">
                    @Html.Partial("_LoginPartial")
                </div>
            </div>
        </nav>
    </header>
    <!-- Header end -->
    <div>
        @RenderBody()
    </div>
    <footer>
        <section class="dpFooter">
            <div class="upper">
                <div class="footbox">
                    <div class="footImg">
                        <img src="~/images/dp mart 2.png" />

                    </div>
                    <div class="footAbout">

                        Lorem ipsum dolor sit amet consectetur adipisicing elit. Rem nulla itaque obcaecati impedit
                        similique adipisci quis eveniet iste iure.

                    </div>
                </div>
                <div class="footbox boxmid">
                    <ul>
                        <h3>Categories</h3>
                        <li><a href="#">first</a></li>
                        <li><a href="#">second</a></li>
                        <li><a href="#">third</a></li>
                        <li><a href="#">fourth</a></li>
                        <li><a href="#">fifth</a></li>
                    </ul>
                </div>
                <div class="footbox boxend">
                    <ul>
                        <h3>Contact</h3>
                        <li><a href="#">Contact Us</a></li>
                        <li><a href="#">About Us</a></li>
                    </ul>
                    <div class="Ficons">
                        <i class="fa-brands fa-square-facebook"></i>
                        <i class="fa-brands fa-square-instagram"></i>
                        <i class="fa-brands fa-square-x-twitter"></i>
                        <i class="fa-brands fa-linkedin"></i>
                    </div>
                </div>

            </div>
            <div class="lower">
                <div class="line"></div>
                <div class="lowerbox">
                    <h4>Copyright © 2024 by DP_MART All rights reserved.</h4>
                </div>

            </div>
        </section>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
