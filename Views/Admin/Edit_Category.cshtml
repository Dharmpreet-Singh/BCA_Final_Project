@model ProjectDP.Models.Category

@{
    ViewBag.Title = "Edit_Category";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}

<h2>Edit_Category</h2>


@using (Html.BeginForm("Edit_Category", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    
    <div class="form-horizontal">
        <h4>Category</h4>
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.c_id)

        <div class="form-group">
             <div class="form-label">Category Name :</div>
            <div class="col-md-10">
                @Html.EditorFor(model => model.c_name, new { htmlAttributes = new { @class = "form-control" } })
                @Html.ValidationMessageFor(model => model.c_name, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="form-label">Category Image :</div>
            <div class="col-md-10">
                <img src="@Model.c_image" height="100px" width="100px">
                <input type="file" name="file" />
                @Html.ValidationMessageFor(model => model.c_image, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Save" class="btn btn-default" />
            </div>
        </div>
    </div>
}

<div class="redirect">
    @Html.ActionLink("Back to List", "Category")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
