@model ProjectDP.Models.Contact

@{
    ViewBag.Title = "Del_Feedback";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}

<h2>Del_Feedback</h2>

<h3>Are you sure you want to delete this?</h3>
<div class="disp">
    <div>
        <h4>Feedback</h4>
        <hr />
        <dl class="dl-horizontal">
            <dt>
                @*@Html.DisplayNameFor(model => model.f_name)*@
                First Name
            </dt>

            <dd>
                @Html.DisplayFor(model => model.f_name)
            </dd>

            <dt>
                @*@Html.DisplayNameFor(model => model.l_name)*@
                Last Name
            </dt>

            <dd>
                @Html.DisplayFor(model => model.l_name)
            </dd>

            <dt>
                @*@Html.DisplayNameFor(model => model.email)*@
                E-mail
            </dt>

            <dd>
                @Html.DisplayFor(model => model.email)
            </dd>

            <dt>
                @*@Html.DisplayNameFor(model => model.message)*@
                Message
            </dt>

            <dd>
                @Html.DisplayFor(model => model.message)
            </dd>

            <dt>
                @*@Html.DisplayNameFor(model => model.date)*@
                Date
            </dt>

            <dd>
                @Html.DisplayFor(model => model.date)
            </dd>

        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="redirect">
                <input type="submit" value="Delete" class="btn btn-default" /> |
                @Html.ActionLink("Back to List", "Feedback")
            </div>
        }
    </div>
</div>
