@model IEnumerable<ProjectDP.Models.Product_Dtl_Class>

@{
    ViewBag.Title = "Product_Dtl";
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}

<div class="area">
    <h2>Product Details</h2>

    <p>
        @Html.ActionLink("Create New", "Add_Pdt_Dtl")
    </p>
    <table class="table">
        <tr>

            <th>
                @*@Html.DisplayNameFor(model => model.pd_name)*@
                Product Name
            </th>
            <th>
                @*@Html.DisplayNameFor(model => model.pd_image)*@
                Proudct Image
            </th>
            <th>
                @*@Html.DisplayNameFor(model => model.pd_qunatity)*@
                Proudct Quantity
            </th>
            <th>
                @*@Html.DisplayNameFor(model => model.pd_price)*@
                Product Price
            </th>
            <th> Actions</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @Html.DisplayFor(modelItem => item.pd_name)
                </td>
                <td>
                    @*@Html.DisplayFor(modelItem => item.pd_image)*@
                    <img src="@item.pd_image" alt="Alternate Text" / width="100px">
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.pd_qunatity)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.pd_price)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit_Pdt_Dtl", new { id = item.pd_id }) |
                    @Html.ActionLink("Details", "Pdt_Dtl_Detail", new { id = item.pd_id }) |
                    @Html.ActionLink("Delete", "Del_Pdt_Dtl", new { id = item.pd_id })
                </td>
            </tr>
        }

    </table>

</div>
